  "cross_system_contract": {
    "rules": [
      "Body and facial emotion must agree unless a deliberate conflicted performance is explicitly authored.",
      "Gaze must support the active performance intent.",
      "Dialogue state must agree with mouth and speech performance.",
      "Body performance must agree with dialogue intent.",
      "Supernatural facial activation requires supernatural causal state.",
      "Supernatural body activation requires supernatural causal state.",
      "Causal events must belong to the active scene or explicitly inherited state.",
      "A performance cannot silently alter canonical identity.",
      "A performance cannot silently alter clothing or body structure.",
      "A performance state must inherit continuity from the previous shot unless an explicit transition exists."
    ]
  },
